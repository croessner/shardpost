# syntax=docker/dockerfile:1
#
# Lint environment: the same Ceph 20 (Tentacle) build base as Dockerfile, so
# the cgo packages (go-ceph/librados) type-check, plus a pinned golangci-lint.
# The source is mounted at run time (make lint); nothing is copied in.
FROM quay.io/ceph/ceph:v20.2.4-20260818
ARG GOLANGCI_LINT_VERSION
RUN test -n "$GOLANGCI_LINT_VERSION" \
 && dnf -y install centos-release-ceph-tentacle \
 && dnf -y install librados-devel gcc \
 && dnf clean all && rm -rf /var/cache/dnf \
 && curl -fsSL -o /tmp/lint.tgz "https://github.com/golangci/golangci-lint/releases/download/v${GOLANGCI_LINT_VERSION}/golangci-lint-${GOLANGCI_LINT_VERSION}-linux-amd64.tar.gz" \
 && tar -xzf /tmp/lint.tgz -C /tmp \
 && install -m 0755 "/tmp/golangci-lint-${GOLANGCI_LINT_VERSION}-linux-amd64/golangci-lint" /usr/local/bin/golangci-lint \
 && rm -rf /tmp/lint.tgz /tmp/golangci-lint-* \
 && mkdir -p /cache/go /cache/lint && chmod -R 1777 /cache
COPY --from=golang:1.27 /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:$PATH CGO_ENABLED=1 GOFLAGS=-mod=vendor \
    GOCACHE=/cache/go GOLANGCI_LINT_CACHE=/cache/lint HOME=/tmp
WORKDIR /src
ENTRYPOINT ["golangci-lint"]
