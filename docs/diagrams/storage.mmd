flowchart LR
    subgraph Index[shardpost-index / Namespace Konto]
        Registry[mailboxes: Namen, IDs, Quota, Delivery-Intents]
        Header[mbox/ID: Header, Journal, Shard 0]
        Higher[mbox/ID/N: höhere UID-Shards]
        FTS[fts + ftsd + ftsmap]
        Scripts[Sieve-Skripte / Metadaten]
        Scrub[Scrub-Kandidaten]
        Registry -->|stabile ID| Header
        Header -->|UID zu Shard| Higher
    end
    subgraph Data[shardpost-data / Namespace Konto]
        First[msg/GUID/0 + refs]
        Rest[msg/GUID/1 ... N]
        First --- Rest
    end
    Header -->|GUID| First
    Higher -->|GUID| First
    FTS -->|Doc-ID zu GUID| First
    subgraph Learning[shardpost-data / Namespace ~learning]
        Jobs[learning/JobID: Nachricht + Job-xattr]
    end
