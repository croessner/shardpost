stateDiagram-v2
    [*] --> NotAuthenticated: connection / greeting
    NotAuthenticated --> Authenticated: successful login
    state Authenticated {
        [*] --> Unselected
        Unselected --> Selected: SELECT / EXAMINE
        Selected --> Unselected: CLOSE / UNSELECT
    }
    Authenticated --> NotAuthenticated: UNAUTHENTICATE
    NotAuthenticated --> Logout: LOGOUT / end of transport
    Authenticated --> Logout: LOGOUT / end of transport
    Logout --> [*]: release resources
