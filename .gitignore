# Scratch plans and notes (temp/.gitignore ignores its content as well)
/temp/

# IDE and OS files
/.idea/
.DS_Store

# Python caches (programs/, hack/)
__pycache__/
*.pyc

# Local build output
/shardpost
/shardpostctl
/shardpost-load
/third_party/go-sieve/cmd/sieve-run/sieve-run
*.test
*.out

# Website build output (website/)
/website/dist/
/website/.venv/
/website/deploy/.env

# graphify knowledge graph (local build output, rebuilt by the git hooks)
/graphify-out/

# Claude Code worktrees (only .claude/settings.json is shared)
/.claude/worktrees/
