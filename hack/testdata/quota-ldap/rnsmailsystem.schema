# Copy of mailstack runtime/openldap/config/schema/rnsmailsystem.schema
# (test fixture for hack/quota-flag-ldap-test.sh; the provider owns the
# original).
# RNS           - 1.3.6.1.4.1.31612
# LDAP          - 1.3.6.1.4.1.31612.1
# Mail          - 1.3.6.1.4.1.31612.1.1
# Attributes    - 1.3.6.1.4.1.31612.1.1.1
# ObjectClasses - 1.3.6.1.4.1.31612.1.1.2

attributetype ( 1.3.6.1.4.1.31612.1.1.1.1
  NAME 'rnsMSEnablePostfix'
  DESC 'Indicator to enable or disable a mailbox'
  EQUALITY booleanMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.7 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.2
  NAME 'rnsMSRecipientAddress'
  DESC 'Receive mail for the given mail address'
  EQUALITY caseIgnoreIA5Match
  SUBSTR caseIgnoreIA5SubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26{256} )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.3
  NAME 'rnsMSDeliverToAddress'
  DESC 'Send  mail to the given mail address'
  EQUALITY caseIgnoreIA5Match
  SUBSTR caseIgnoreIA5SubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26{256} )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.4
  NAME 'rnsMSVirtDomain'
  DESC 'Receive mail for the given domain'
  EQUALITY caseIgnoreIA5Match
  SUBSTR caseIgnoreIA5SubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.5
  NAME 'rnsMSEnableDovecot'
  DESC 'Indicator to enable or disable IMAP support'
  EQUALITY booleanMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.7 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.6
  NAME 'rnsMSQuota'
  DESC 'An integer that represents the quota on a mailbox'
  EQUALITY integerMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.27 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.7
  NAME 'rnsMSMailboxHome'
  DESC 'The absolute path to a mail account'
  EQUALITY caseExactIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.8
  NAME 'rnsMSMailPath'
  DESC 'The relative path to the mail directory inside a mailbox account'
  EQUALITY caseExactIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.9
  NAME 'rnsMSSievePath'
  DESC 'The relative path to the sieve directory inside a mailbox account'
  EQUALITY caseExactIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.10
  NAME 'rnsMSClearPassword'
  DESC 'Cleartext password for the mail account'
  EQUALITY octetStringMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.40{128} )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.11
  NAME 'rnsMSRejectMsg'
  DESC 'Reject code for check_helo_access'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.12
  NAME 'rnsMSDKIMKey'
  DESC 'DKIM signing key'
  EQUALITY caseExactIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.13
  NAME 'rnsMSDKIMKeyName'
  DESC 'DKIM keyname'
  EQUALITY caseExactIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.14
  NAME 'rnsMSDovecotUser'
  DESC 'Dovecot user account name'
  EQUALITY caseIgnoreIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.15
  NAME 'rnsMSDKIMDomain'
  DESC 'DKIM d header field'
  EQUALITY caseIgnoreIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.16
  NAME 'rnsMSDKIMIdentity'
  DESC 'DKIM i header field'
  EQUALITY caseIgnoreIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.17
  NAME 'rnsMSPostfixTransport'
  DESC 'A Postfix transport map destination'
  EQUALITY caseExactIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.18
  NAME 'rnsMSAbuseId'
  DESC 'An Abuse identifier that is unique to each mail account'
  EQUALITY caseExactIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.19
  NAME 'rnsMSPwdResetMail'
  DESC 'Alternative mail address that is used to send a password reset link'
  EQUALITY caseIgnoreIA5Match
  SUBSTR caseIgnoreIA5SubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26{256} )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.20
  NAME 'rnsMSACLGroups'
  DESC 'Dovecot acl_groups extra field for user_attrs'
  EQUALITY caseExactIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.21
  NAME 'rnsMSRequireTls'
  DESC 'DATA command requires a TLS encrypted connection'
  EQUALITY booleanMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.7 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.22
  NAME 'rnsMSACLGroup'
  DESC 'Dovecot acl_groups extra field for post login script'
  EQUALITY caseExactIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.23
  NAME 'rnsMSPostfixRateLimit'
  DESC 'An integer that represents the sender rate limit'
  EQUALITY integerMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.27 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.24
  NAME 'rnsMSDovecotMaster'
  DESC 'Mark Dovecot account as a master user account'
  EQUALITY booleanMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.7 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.25
  NAME 'rnsMSTLSClientCertRequired'
  DESC 'Check if a TLS client cert is required for the email communication'
  EQUALITY booleanMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.7 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.26
  NAME 'rnsMSDovecotFTS'
  DESC 'Dovecot FTS implementation'
  EQUALITY caseIgnoreIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.27
  NAME 'rnsMSDovecotFTSSolrUrl'
  DESC 'Dovecot FTS SOLR host'
  EQUALITY caseIgnoreIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.28
  NAME 'rnsMSOverQuota'
  DESC 'Indicator for mailbox over quota'
  EQUALITY booleanMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.7 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.29
  NAME 'rnsMSIMAPLastLogin'
  DESC 'Unix Timestamp of the last IMAP login'
  EQUALITY integerMatch
  ORDERING integerOrderingMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.27 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.30
  NAME 'rnsMSSMTPLastLogin'
  DESC 'Unix Timestamp of the last SMTP login'
  EQUALITY integerMatch
  ORDERING integerOrderingMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.27 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.31
  NAME 'rnsMSEmailVerified'
  DESC 'Indicator that the email address has been verified'
  EQUALITY booleanMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.7 SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.31612.1.1.1.32
  NAME 'rnsMSPhoneNumberVerified'
  DESC 'Indicator that the phone number has been verified'
  EQUALITY booleanMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.7 SINGLE-VALUE )

objectclass ( 1.3.6.1.4.1.31612.1.1.2.1
  NAME 'rnsMSPostfixAccount'
  DESC 'Postfix account for virtual domain mailboxes'
  SUP top AUXILIARY
  MAY ( rnsMSEnablePostfix $ rnsMSRecipientAddress $
  rnsMSDeliverToAddress $ rnsMSClearPassword $ rnsMSAbuseId $
  rnsMSPwdResetMail $ rnsMSRequireTls $ rnsMSPostfixTransport $
  rnsMSPostfixRateLimit $ rnsMSSMTPLastLogin ) )

objectclass ( 1.3.6.1.4.1.31612.1.1.2.2
  NAME 'rnsMSDovecotAccount'
  DESC 'Dovecot account for virtual domain mailboxes'
  SUP top AUXILIARY
  MUST ( rnsMSDovecotUser )
  MAY ( rnsMSEnableDovecot $ rnsMSQuota $ rnsMSMailboxHome $
  rnsMSMailPath $ rnsMSSievePath $ rnsMSClearPassword $
  rnsMSACLGroups $ rnsMSACLGroup $ rnsMSDovecotMaster $
  rnsMSDovecotFTS $ rnsMSDovecotFTSSolrUrl $ rnsMSOverQuota $
  rnsMSIMAPLastLogin ) )

objectclass ( 1.3.6.1.4.1.31612.1.1.2.3
  NAME 'rnsMSPostfixGroup'
  DESC 'Postfix group for check_helo_access and virtual_domain_maps'
  SUP top AUXILIARY
  MUST ( rnsMSVirtDomain )
  MAY ( rnsMSRejectMsg $ rnsMSPostfixTransport ) )

objectclass ( 1.3.6.1.4.1.31612.1.1.2.4
  NAME 'rnsMSDKIM'
  DESC 'OpenDKIM KeyTable and SigningTabe container'
  SUP top STRUCTURAL
  MUST ( rnsMSDKIMKeyName )
  MAY ( rnsMSDKIMKey $ rnsMSDKIMDomain $ rnsMSDKIMIdentity ) )

objectclass ( 1.3.6.1.4.1.31612.1.1.2.5
  NAME 'rnsMSGeneralPurpose'
  DESC 'This objectClass is a general purpose class for common mail settings'
  SUP top AUXILIARY
  MAY ( rnsMSTLSClientCertRequired $ rnsMSEmailVerified $
  rnsMSPhoneNumberVerified ) )
